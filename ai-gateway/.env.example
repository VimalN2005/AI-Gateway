# Gateway
PORT=8000
JWT_SECRET=your-super-secret-key-change-in-production
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# Service URLs (internal Docker network names)
NLP_SERVICE_URL=http://nlp-service:5001
VISION_SERVICE_URL=http://vision-service:5002
EMBEDDING_SERVICE_URL=http://embedding-service:5003

# Rate Limiting
RATE_LIMIT_FREE=10        # req/min
RATE_LIMIT_PRO=100        # req/min

# Cache TTL (seconds)
CACHE_TTL_NLP=300
CACHE_TTL_VISION=600
CACHE_TTL_EMBED=3600

# Dashboard
DASHBOARD_PORT=3000
VITE_GATEWAY_URL=http://localhost:8000
